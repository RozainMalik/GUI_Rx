# Run settings. Every value can be overridden from the environment, e.g. MODEL_SIZE=4b bash scripts/run_stages.sh all
: "${MODEL_SIZE:=2b}"                         # 2b | 4b | 9b
: "${MODEL_ROOT:=models}"                     # where the Qwen3.5 base checkpoints live
case $MODEL_SIZE in
  2b) : "${MODEL:=$MODEL_ROOT/Qwen3.5-2B}"; : "${EXPECT_TRAINABLE:=8.0e7,1.0e8}" ;;   # 6 full-attention blocks + 5 token rows = 88.1M
  4b) : "${MODEL:=$MODEL_ROOT/Qwen3.5-4B}"; : "${EXPECT_TRAINABLE:=2.8e8,3.1e8}" ;;   # 8 blocks + 5 rows = 293.6M
  9b) : "${MODEL:=$MODEL_ROOT/Qwen3.5-9B}"; : "${EXPECT_TRAINABLE:=4.5e8,4.9e8}" ;;   # 8 blocks + 5 rows = 469.8M
  *) echo "MODEL_SIZE must be 2b, 4b or 9b" >&2; exit 2 ;;
esac
: "${RUN_ROOT:=runs/$MODEL_SIZE}"
: "${DATA:=configs/data_45k.yaml}"            # used only when scripts/train.sh is called directly
: "${OUT:=$RUN_ROOT/custom}"
: "${LR:=5e-6}"
: "${GA:=8}"                                  # global batch 8 = 1 GPU x batch 1 x accumulation 8
: "${OPTIM:=adamw_torch_fused}"               # the clinical stage uses adamw_bnb_8bit (scripts/run_stages.sh)
: "${MAX_PIXELS:=5860400}"
: "${SAVE_STEPS:=500}"
: "${SMOKE_MAX_RESERVED_GIB:=40}"             # smoke-test memory budget on the largest images
: "${PYTHON:=.venv/bin/python}"
